{
  "name": "@usesonar/react",
  "version": "0.0.0",
  "description": "React hooks for streaming Sonar research.",
  "homepage": "https://github.com/usesonar/monorepo/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/usesonar/monorepo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usesonar/monorepo.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --platform neutral --external react --external @tanstack/react-query --external effect --external @usesonar/effect --tsconfig ../../tsconfig.react.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.6",
    "@usesonar/effect": "0.0.0",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "bun-types": "1.4.0",
    "happy-dom": "20.11.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "peerDependencies": {
    "react": "19.2.8"
  }
}
