{
  "name": "@usesonar/effect",
  "version": "0.0.0",
  "description": "Effect client, Layers, and deterministic testing utilities for Sonar.",
  "homepage": "https://github.com/usesonar/monorepo/tree/main/packages/effect#readme",
  "bugs": {
    "url": "https://github.com/usesonar/monorepo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usesonar/monorepo.git",
    "directory": "packages/effect"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "tsdown src/index.ts src/testing.ts --format esm --dts --clean --platform neutral --external effect --external @usesonar/api --tsconfig ../../tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@usesonar/api": "0.0.0",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "bun-types": "1.4.0"
  }
}
