{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@usesonar/api": ["./packages/api/src/index.ts"],
      "@usesonar/backend": ["./packages/backend/src/index.ts"],
      "@usesonar/backend/testing": ["./packages/backend/src/testing.ts"],
      "@usesonar/effect": ["./packages/effect/src/index.ts"],
      "@usesonar/effect/testing": ["./packages/effect/src/testing.ts"],
      "@usesonar/eve": ["./packages/eve/src/index.ts"],
      "@usesonar/react": ["./packages/react/src/index.ts"]
    }
  }
}
